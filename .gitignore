# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# 运行时状态（含管理员 PAT 缓存、活动发放记录，绝不能进仓库）
data/
!data/.gitkeep

# 本地环境变量（含密钥）
.env
.env.*
!.env.example

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store

# 本地演示产物：早期用于脱离后端演示界面的静态副本，与运行时无关，
# 也不进生产镜像（见 .dockerignore）。保留在工作区方便本地回看，不进仓库。
dist/
demo/

# .workbuddy/ 存项目记忆与内部运维细节，**不入库**。
# 2026-10-20 纠正：此前刻意跟踪，导致该目录随提交进入公开仓库（泄露内部架构）。
# 记忆需要共享时走私有渠道，不要靠 git。
.workbuddy/
