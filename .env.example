# 复制为 .env 后填写。.env 已在 .gitignore 中，切勿提交。
#
#   cp .env.example .env
#
# 本文件按**生产部署**给默认值。docker-compose.yml 不提供任何降级开关：
# 下面标「必填」的项没填，compose 会直接拒绝启动（${VAR:?} 语法），
# 这是刻意设计 —— 带着错配上线比起不来危险得多。
#
# 本地开发不要用这份配置，直接跑 uvicorn 并用环境变量覆盖：
#   BFF_MOCK_MODE=1 BFF_COOKIE_SECURE=0 BFF_SECRET_KEY=$(openssl rand -hex 32) \
#     uvicorn app.main:app --reload

# ==================== 必填（缺一项就起不来）====================

# 会话 Cookie 加密密钥。生成：openssl rand -hex 32
#
# 经 HKDF-SHA256 派生出 AES-256-GCM 密钥，加密会话载荷里的用户 PAT，
# 同时承担防伪造。弱密钥 = 别人既能冒充任意用户、也能解出其 PAT。
# /readyz 会拦空值、短于 32 字符、以及已知弱值，不通过直接 503。
#
# 注意：换这个值会让所有在线会话立即失效（旧密文解不开），用户需重新登录，
# 轮换请安排在低峰期。
BFF_SECRET_KEY=

# 上游 new-api 地址。不给默认值是刻意的：默认指向某个具体站点时，
# 一旦忘配就会把全部用户流量静默打到别人的实例上。
NEWAPI_BASE_URL=

# ---- 管理员凭证：PAT 与账密都必填，二者不是替代关系 ----
#
# PAT 是主通道：走 users.access_token 列，完全不经过 new-api 的会话系统，
# 从根本绕开「50 会话硬上限打满后 login 永久 409」这个最高危单点故障。
# 获取：管理员在 new-api 前端「个人设置 → 系统访问令牌」生成。
NEWAPI_ADMIN_PAT=
NEWAPI_ADMIN_UID=

# 账密是 PAT 失效后的**唯一自愈通道**，生产同样必填。
# 原因：GET /api/user/token 每次调用都会重新生成 PAT 并作废旧值 —— 管理员在
# 官方前端点一次「系统访问令牌」，这里配的 PAT 就失效了。此时代码会用账密
# 自动重新换取（newapi_client.py 的 401 分支）；没有账密就只能人工改配置 + 重启。
NEWAPI_ADMIN_USERNAME=
NEWAPI_ADMIN_PASSWORD=

# 镜像版本标签，必填 —— 让它落到 dev/unknown 等于放弃线上问题的回溯能力。
#   APP_VERSION=$(git describe --tags --always)
#   VCS_REF=$(git rev-parse --short HEAD)
APP_VERSION=
VCS_REF=

# ==================== 可选（有生产就绪默认值）====================

# 构建用的 Python 基础镜像。默认 python:3.13-slim。
# 拉不到时（Docker Hub 抽风 / 内网 / 镜像站滞后）可降级或指向私有源：
#   PYTHON_IMAGE=python:3.12-slim              # 代码 requires-python >=3.12
#   PYTHON_IMAGE=my-mirror/library/python:3.13-slim
PYTHON_IMAGE=python:3.13-slim

# 宿主机监听端口。只绑 127.0.0.1，TLS 由外层 Nginx/Caddy 终止。
BFF_PORT=8000

# 信任 X-Forwarded-For 的来源。
# 默认 127.0.0.1 只适用于「反代与容器共享 network namespace」的少数情况。
# 更常见的是反代在宿主机、请求经 docker 网桥进来，此时源 IP 是网桥网段
# （如 172.17.0.1），必须按实际网段放行，否则 uvicorn 丢弃 XFF、
# 限流会把所有用户当成同一个 IP 误伤。用 docker network inspect bridge 查网段。
# 绝不能填 *：等于允许任意客户端自带伪造 XFF 绕过按 IP 限流。
FORWARDED_ALLOW_IPS=127.0.0.1

# 导入链接 / 指令文档里 BFF 自身的对外 origin（含协议）。
# 默认留空即可：**动态**取当前请求域名与协议，换域名部署自动适配，无需改配置。
# 协议优先级：X-Forwarded-Proto 头 > 公网标准域名(443/无端口)推断为 https >
# 本地裸跑回落 http。绝大多数部署什么都不用填。
# 仅当反代完全无法透传 Host / X-Forwarded-* 头（极罕见）时，才用此变量兜底：
#   SETUP_PUBLIC_ORIGIN=https://你的域名

# 会话 Cookie 的 SameSite 属性。默认 lax，**做在线支付就不要改成 strict**：
# 用户从支付网关点「返回商户」是跨站顶层导航，strict 下浏览器不带 Cookie，
# 落地后显示未登录、看不到充值结果 —— 而钱其实已经到账（走 notify_url），
# 极易被当成「付了钱没到账」而引发客诉。
# lax 只放行顶层导航的 GET/HEAD，本项目所有写操作都是 POST，防护已经足够。
# 仅当本站完全不做在线支付时，才值得收紧到 strict。
BFF_COOKIE_SAMESITE=lax

# 注意：BFF_MOCK_MODE 与 BFF_COOKIE_SECURE 在 docker-compose.yml 里写死为
# 0 和 1，不从 .env 读取。生产不提供关闭途径（前者会让你对着假数据运营，
# 后者会让登录凭证在明文 HTTP 上传输）。本地调试请直接跑 uvicorn 覆盖。

# ==================== 积分与活动 ====================
# 运营策略项，直接决定真金白银的赠送额度。
# 注意 PROMO_* 默认是**开启**的，不做活动必须显式设 0。
BFF_POINTS_PER_CNY=10000
BFF_PROMO_SIGNUP_ENABLED=1
BFF_PROMO_SIGNUP_POINTS=20000
BFF_PROMO_FIRST_TOPUP_ENABLED=1
BFF_PROMO_FIRST_TOPUP_RATE=1.0

# ==================== 品牌 ====================
# 留空不影响功能，只是页面少显示对应信息。
# 国内公网运营需要 ICP 备案号，按合规要求填写。
BFF_BRAND_NAME=NexusAPI
# 留空则自动取 NEWAPI_BASE_URL + /v1
BFF_API_BASE_URL=
BFF_BRAND_ICP=
BFF_BRAND_CONTACT=

# ==================== 可观测性（Logfire）====================
# 留空则完全关闭，不装 SDK 也能跑，本地开发无需配置。
# 填入 token 后自动上报请求 trace、未捕获异常、对 new-api 的出站调用。
# token 在 https://logfire.pydantic.dev 项目设置里取。
LOGFIRE_TOKEN=
# 上报环境名，用于在控制台区分 local/staging/production
LOGFIRE_ENVIRONMENT=production
