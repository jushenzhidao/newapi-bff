# 复制为 .env 后填写。.env 已在 .gitignore 中，切勿提交。
#
#   cp .env.example .env

# ==================== 必填 ====================
# 会话 Cookie 签名密钥。生成：openssl rand -hex 32
# 用默认值 / 空值时 /readyz 返回 503，容器不会进入健康状态。
BFF_SECRET_KEY=

# ==================== 上游 new-api ====================
NEWAPI_BASE_URL=https://api.aihuobao.cn

# 管理员凭证：PAT 或账密，二者至少配一组，否则 /readyz 返回 503。
# 源码里不留默认账密 —— 本仓库有公开 remote，默认值会随仓库和镜像一起分发，
# 等同公开后台管理员密码。
#
# 优先用 PAT：它走 users.access_token 列，不经过会话系统。而账密 login 每次
# 消耗一个会话配额，new-api 上限 50 且硬拒绝、TTL 30 天，打满后 30 天内无法
# 登录，BFF 的建号/加额度/兑换码会全线瘫痪。配了 PAT 就彻底不需要 login。
# 获取：管理员在 new-api 前端「个人设置 → 系统访问令牌」生成。
NEWAPI_ADMIN_PAT=
NEWAPI_ADMIN_UID=

# 兜底账密（配了 PAT 就留空）
NEWAPI_ADMIN_USERNAME=
NEWAPI_ADMIN_PASSWORD=

# ==================== 运行 ====================
# 1 = 内存 mock 演示模式，不连上游；生产必须为 0
BFF_MOCK_MODE=0

# 宿主机监听端口（只绑 127.0.0.1，由外层反代做 TLS）
BFF_PORT=8000

# 信任 X-Forwarded-For 的来源。反代经 docker 网桥进来时填网桥网段，
# 例如 172.16.0.0/12；填 * 等于允许任意客户端伪造 IP 绕过上游限流。
FORWARDED_ALLOW_IPS=127.0.0.1

# 镜像版本标签（CI 会注入 git sha）
APP_VERSION=dev
VCS_REF=unknown

# ==================== 积分与活动 ====================
BFF_POINTS_PER_CNY=10000
BFF_PROMO_SIGNUP_ENABLED=1
BFF_PROMO_SIGNUP_POINTS=20000
BFF_PROMO_FIRST_TOPUP_ENABLED=1
BFF_PROMO_FIRST_TOPUP_RATE=1.0

# ==================== 品牌 ====================
BFF_BRAND_NAME=NexusAPI
# 留空则自动取 NEWAPI_BASE_URL + /v1
BFF_API_BASE_URL=
BFF_BRAND_ICP=
BFF_BRAND_CONTACT=
